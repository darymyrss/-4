package main

import (
	"github.com/skip2/go-qrcode"
	"log"
)

func main() {
	url := "https://google.com"
	fileName := "qrcode.png"

	// Добавила проверку на ошибки, чтобы знать, если что-то пойдет не так
	err := qrcode.WriteFile(url, qrcode.Medium, 256, fileName)
	if err != nil {
		log.Fatal(err)
	}
}
